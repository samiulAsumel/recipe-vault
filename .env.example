# Base URL of the deployed world-kitchen-atlas-proxy Worker (see worker/index.ts).
# Read at build time only (generateStaticParams / server components) — never
# exposed to client JS, so it is NOT prefixed with NEXT_PUBLIC_.
# Example: https://world-kitchen-atlas-proxy.<your-subdomain>.workers.dev
DATA_API_URL=

# Same Worker URL, but readable from the browser — the /admin panel is a
# client-side SPA (static export has no server runtime) and calls the Worker's
# /admin/* endpoints directly, so this one IS NEXT_PUBLIC_-prefixed.
NEXT_PUBLIC_DATA_API_URL=
