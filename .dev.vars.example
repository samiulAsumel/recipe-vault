# Copy to .dev.vars (gitignored) and fill in for local `next dev` / wrangler dev.
# In production these are set as Worker secrets, never committed:
#   npx wrangler secret put GITHUB_OWNER
#   npx wrangler secret put GITHUB_REPO
#   npx wrangler secret put GITHUB_TOKEN
#   npx wrangler secret put SESSION_SECRET

# Owner of the private GitHub repo that stores recipes/{country-slug}.json
GITHUB_OWNER=

# Name of the private GitHub repo
GITHUB_REPO=

# Fine-grained PAT, Contents: Read-only (Read+Write once the admin panel writes back), scoped to GITHUB_REPO only
GITHUB_TOKEN=

# Optional - path inside the repo where country JSON files live. Defaults to "recipes".
GITHUB_RECIPES_PATH=recipes

# Long random string signing the admin session cookie (Section 8). Generate with e.g.
# `openssl rand -base64 32`. Never reuse across environments; never commit the real value.
SESSION_SECRET=

