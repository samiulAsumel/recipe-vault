{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "world-kitchen-atlas",
	"compatibility_date": "2026-07-27",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, required by OpenNext's caching layer.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "world-kitchen-atlas"
		}
	],
	"kv_namespaces": [
		{
			// Section 10 visit counters. Local dev works with this placeholder id (Miniflare
			// simulates KV locally regardless). Before deploying: `npx wrangler kv namespace
			// create ANALYTICS_KV`, then replace the id below with the one it prints.
			"binding": "ANALYTICS_KV",
			"id": "REPLACE_WITH_REAL_KV_NAMESPACE_ID"
		}
	]
}
